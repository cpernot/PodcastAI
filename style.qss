QMainWindow {
    background-color: #121212;
    color: #e1e1e1;
}

QWidget {
    background-color: #121212;
    color: #e1e1e1;
    font-family: 'Segoe UI', sans-serif;
    font-size: 14px;
}

QTableWidget {
    background-color: #1e1e1e;
    alternate-background-color: #252525;
    border: 1px solid #333333;
    gridline-color: #333333;
    border-radius: 8px;
    selection-background-color: #3d3d3d;
}

QTableWidget::item {
    padding: 10px;
}

QHeaderView::section {
    background-color: #2d2d2d;
    padding: 6px;
    border: none;
    font-weight: bold;
}

QPushButton {
    background-color: #bb86fc;
    color: #000000;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #cfabfc;
}

QPushButton:pressed {
    background-color: #9965f4;
}

QPushButton#secondaryButton {
    background-color: transparent;
    color: #bb86fc;
    border: 1px solid #bb86fc;
}

QPushButton#secondaryButton:hover {
    background-color: rgba(187, 134, 252, 0.1);
}

QLabel#titleLabel {
    font-size: 24px;
    font-weight: bold;
    color: #ffffff;
    margin-bottom: 20px;
}

QListWidget {
    background-color: #1e1e1e;
    border: 1px solid #333333;
    border-radius: 8px;
    padding: 5px;
}

QListWidget::item {
    background-color: #2d2d2d;
    border-radius: 4px;
    margin-bottom: 4px;
    padding: 8px;
}

QListWidget::item:selected {
    background-color: #3d3d3d;
    border: 1px solid #bb86fc;
}

QProgressBar {
    border: 1px solid #333333;
    border-radius: 4px;
    text-align: center;
    background-color: #1e1e1e;
}

QProgressBar::chunk {
    background-color: #03dac6;
    width: 20px;
}
